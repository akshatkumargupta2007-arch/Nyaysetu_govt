# Names only. Run `npm run gov:keys` to generate real values into .env (never commit .env).
# Where the citizen app (NyaySetu_Full_v2) lives, if it is not a sibling folder of this one. Optional: the scripts
# also look in ~/Documents/NyaySetu_Full_v2.
CITIZEN_DIR=
GOV_DB_PASSWORD=
# Password of the restricted gov_app database role the API connects as.
GOV_APP_DB_PASSWORD=
# In production this must be the gov_app user. The migration needs the database OWNER, so give its URL separately.
DATABASE_URL=
MIGRATE_DATABASE_URL=
PORT=8081
SYNC_PORT=8091
GOV_WEB_ORIGIN=http://localhost:5174
CITIZEN_INTERNAL_URL=http://citizen-api:8090
# How many reverse proxies are in front of the API (0 = none). REQUIRED in production. Never "true".
TRUST_PROXY=0
GOV_JWT_PRIVATE_KEY=
GOV_JWT_PUBLIC_KEY=
SYNC_SIGNING_PUBLIC_KEY=
GOV_WRITEBACK_PRIVATE_KEY=
GOV_PHONE_SEAL_PRIVATE_KEY=
GOV_PHONE_SEAL_PUBLIC_KEY=
# First administrator. In production GOV_ADMIN_EMAIL must be a real address (not @nyaysetu.local) and the password
# at least 14 characters; no demo accounts are created.
GOV_ADMIN_EMAIL=
GOV_ADMIN_PASSWORD=

# Google Maps browser key for the citizen app's Where / Status screens (full stack). Empty = static picture.
VITE_GOOGLE_MAPS_API_KEY=
