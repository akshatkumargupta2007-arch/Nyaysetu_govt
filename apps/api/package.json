{
  "name": "@nyaysetu-gov/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "synth": "tsx --env-file-if-exists=../../.env src/db/synth.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "test": "vitest run",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:prod": "node dist/db/seed.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
